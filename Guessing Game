def check_numbers():
   for i in range(1,6):
       i = int(input("Choose a number 1 through 6 "))
      
       if i % 2 == 0:
           print(i, "is even")
       else:
           print(i, 'is odd')


check_numbers()


def guessing_game():
   secret = 7
   guess = 0


   while guess != secret:
       guess = int(input("Choose a number 1 through 10 "))


       if guess < secret:
           print("Too low!")
       elif guess > secret:
           print("Too high!")
       else:
           print("You got it!")
           break


guessing_game()
